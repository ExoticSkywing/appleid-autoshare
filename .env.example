APP_ENV=production
APP_HOST_BIND=127.0.0.1
APP_HOST_PORT=18740

# Generate each with: openssl rand -hex 32
ID_HMAC_SECRET=replace-with-at-least-32-random-characters
STATE_HMAC_SECRET=replace-with-at-least-32-random-characters
# Redis configuration for external host Redis (e.g. Pagoda / aaPanel Redis)
REDIS_URL=redis://:your-redis-password@host.docker.internal:6379/1
REDIS_PREFIX=autoshare:v2

# Approved upstream endpoints. Keep these values only in the deployment .env.
SOURCE_A_URL=
SOURCE_A_POLL_SECONDS=45
SOURCE_B_URL=
SOURCE_B_REFERER=
SOURCE_B_POLL_SECONDS=90

# Optional authenticated reserve. URL and opaque Cookie are runtime secrets;
# leave disabled unless both are injected by the deployment secret manager.
SOURCE_C_ENABLED=false
SOURCE_C_URL=
SOURCE_C_COOKIE=
SOURCE_C_POLL_SECONDS=300
SOURCE_C_SAMPLE_COUNT=3
SOURCE_C_SAMPLE_JITTER_MIN_MS=250
SOURCE_C_SAMPLE_JITTER_MAX_MS=750
SOURCE_C_FRESHNESS_SECONDS=600
SOURCE_C_UPSTREAM_MAX_AGE_SECONDS=900
SOURCE_C_SLICE_TTL_SECONDS=1200
SOURCE_C_TIMEZONE=UTC
SOURCE_C_AUTH_FAILURE_ALERT_THRESHOLD=3

# Optional authenticated JSON reserve. URL, Cookie, and Referer are runtime
# secrets and must remain empty in committed files.
SOURCE_D_ENABLED=false
SOURCE_D_URL=
SOURCE_D_COOKIE=
SOURCE_D_REFERER=
SOURCE_D_POLL_SECONDS=300
SOURCE_D_FRESHNESS_SECONDS=300
SOURCE_D_SLICE_TTL_SECONDS=600

# Server-side delivery selector; never expose this choice to browser clients.
# all | primary_only | source_a_only | source_b_only | reserve_only |
# source_d_only | ikuuu_only (the last two are server-side aliases)
DELIVERY_SOURCE_MODE=all
UPSTREAM_TIMEOUT_SECONDS=8
UPSTREAM_MAX_RESPONSE_BYTES=1048576

# 60 seconds is the hard maximum accepted age per source slice.
# A 90-second poll therefore creates an intentional fail-closed gap unless
# SOURCE_B_POLL_SECONDS is reduced after confirming upstream permission.
SOURCE_FRESHNESS_SECONDS=60
SOURCE_SLICE_TTL_SECONDS=90
POOL_TTL_SECONDS=60
POOL_FRESHNESS_SECONDS=60

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=share.example.com
TURNSTILE_EXPECTED_ACTION=reveal
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
TURNSTILE_SCRIPT_URL=https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit
TURNSTILE_TEST_MODE=false
TURNSTILE_TEST_TOKEN=

COOKIE_SECURE=true
PUBLIC_ORIGIN=https://share.example.com
TRUST_PROXY_HEADERS=false
PROXY_IP_HEADER=CF-Connecting-IP
START_POLLERS=true
LOG_LEVEL=INFO

# Optional HTTPS fallback returned with every account reveal. The frontend uses
# it as both an early exit and the final exhausted-pool fallback.
STORE_URL=
